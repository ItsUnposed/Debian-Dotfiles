{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "debian_small",
    "color": {
      "1": "38;2;224;90;155",
      "2": "38;2;224;90;155"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 1
    }
  },

  "display": {
    "separator": " -> ",
    "color": {
      "keys": "38;2;224;90;155"
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "1;38;2;224;90;155",
        "at":   "1;38;2;224;90;155",
        "host": "1;38;2;224;90;155"
      }
    },
    { "type": "os",     "key": "OS " },
    { "type": "kernel", "key": "KRN" },
    { "type": "cpu",    "key": "CPU" },
    { "type": "gpu",    "key": "GPU" },
    { "type": "memory", "key": "MEM" },
    { "type": "uptime", "key": "UP " }
  ]
}
