{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "debian_small",
    "color": {
      "1": "38;2;161;28;18",
      "2": "38;2;255;255;255"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },

  "display": {
    "separator": " -> ",
    "color": {
      "keys": "38;2;161;28;18",
      "title": "38;2;255;106;26"
    }
  },

  "modules": [
    "title",
    { "type": "os",     "key": "OS " },
    { "type": "kernel", "key": "KRN" },
    { "type": "cpu",    "key": "CPU" },
    { "type": "gpu",    "key": "GPU" },
    { "type": "memory", "key": "MEM" },
    { "type": "uptime", "key": "UP " }
  ]
}
