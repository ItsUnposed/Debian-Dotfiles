# --- Syntaxdateien, System zuerst ---
include /usr/share/nano/*.nanorc
include /usr/share/nano/extra/*.nanorc

# --- eigene Regeln, muessen danach kommen ---
include ~/.nano/i3.nanorc

# --- Oberflaeche im Ember-Schema ---
set titlecolor    #011,#6fc
set statuscolor   #011,#6fc
set errorcolor    #eee,#296
set numbercolor   #4d9
set keycolor      #6fc
set functioncolor #eee
set promptcolor   #eee,#011
set selectedcolor #011,#6fc

# --- Komfort ---
set linenumbers
set tabsize 4
set tabstospaces
set constantshow
set softwrap
extendsyntax asm color bold,#6fc "(^|[[:space:]])#.*"
extendsyntax asm color bold,#6fc "//.*"
extendsyntax asm color bold,#6fc start="/\*" end="\*/"
extendsyntax asm color #6fc "(^|[[:space:]])--[[:space:]].*"
extendsyntax asm color #6fc "(^|[[:space:]])%.*"
extendsyntax asm color #6fc "(^|[[:space:]]);.*"
