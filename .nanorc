# --- Syntaxdateien, System zuerst ---
include /usr/share/nano/*.nanorc
include /usr/share/nano/extra/*.nanorc

# --- eigene Regeln, muessen danach kommen ---
include ~/.nano/i3.nanorc

# --- Oberflaeche im Ember-Schema ---
set titlecolor    white,magenta
set statuscolor   white,magenta
set errorcolor    brightwhite,red
set numbercolor   magenta
set keycolor      brightmagenta
set functioncolor white
set promptcolor   white,black
set selectedcolor black,brightmagenta

# --- Komfort ---
set linenumbers
set tabsize 4
set tabstospaces
set constantshow
set softwrap
extendsyntax asm color brightmagenta "(^|[[:space:]])#.*"
extendsyntax asm color brightmagenta "//.*"
extendsyntax asm color brightmagenta start="/\*" end="\*/"
extendsyntax asm color brightmagenta "(^|[[:space:]])--[[:space:]].*"
extendsyntax asm color brightmagenta "(^|[[:space:]])%.*"
extendsyntax asm color brightmagenta "(^|[[:space:]]);.*"
