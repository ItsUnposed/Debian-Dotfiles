set $bg     #1A120F
set $fg     #F2E4DC
set $red    #E0483D
set $orange #FF8C42
set $inact  #3A2A24
set $dim    #8A7A72
set $dkred  #A11C12
set $ltred  #FF6B5E
set $dkred  #A11C12
set $ltred  #FF6B5E

client.focused          $red     $bg      $ltred  $red      $red
client.focused_inactive $inact   $bg      $ltred  $inact    $inact
client.unfocused        $bg      $bg      $ltred  $bg       $bg
client.urgent           $red     $bg      $ltred  $red      $red

default_border normal 2
default_floating_border normal 2

exec_always --no-startup-id feh --no-fehbg --bg-fill $HOME/Pictures/Wallpapers/Omen-Red.png
exec_always --no-startup-id export QT_QPA_PLATFORMTHEME=qt6ct
exec_always --no-startup-id xfsettingsd
exec --no-startup-id export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:$XDG_DATA_DIRS"

# i3 config file
# Mod-Taste: Alt
set $mod Mod1

# Schriftart für Fenstertitel
font pango:DejaVu Sans Mono 10

# Autostart
floating_modifier $mod

# Terminal starten
bindsym $mod+Return exec qterminal

# Fenster schließen
bindsym $mod+q kill

# Programm-Starter (rofi)
bindsym $mod+space exec ~/.config/i3/scripts/rofi-launcher.sh
bindsym $mod+d exec --no-startup-id rofi -show drun -theme ~/.config/rofi/ember.rasi

# Fokus wechseln
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Fenster verschieben
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# Splits
bindsym $mod+h split h
bindsym $mod+v split v

# Vollbild
bindsym $mod+f fullscreen toggle

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus mode_toggle

# Fokus auf Elternfenster
bindsym $mod+a focus parent

# Workspaces wechseln
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
# set $ws10 "10"
# 
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Fenster zu Workspace verschieben
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Config neu laden / i3 neustarten / beenden
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
# bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Willst du wirklich ausloggen?' -B 'Ja' 'i3-msg exit'"

# Fenstergröße ändern
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Fokus folgt Maus
focus_follows_mouse yes

# Gaps
gaps inner 10
gaps outer 5
smart_gaps off

# Autostart
exec_always --no-startup-id xfce4-panel
exec --no-startup-id sh -c "pkill -x picom; sleep 1; picom -b"
exec --no-startup-id ~/.config/i3/hacker-startup.sh
bindsym $mod+Shift+h exec --no-startup-id ~/.config/i3/hacker-startup.sh
exec_always --no-startup-id nm-applet
bindsym $mod+n exec --restart nm-applet

exec_always --no-startup-id sh -c "sleep 1; feh --no-fehbg --bg-fill $HOME/Pictures/Wallpapers/Omen-Red.png"
# client.focused          #4C7899 #285577 #ffffff #2e9ef4 #285577
# client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a
# client.unfocused        #333333 #222222 #888888 #292d2e #222222
# client.urgent           #2f343a #900000 #ffffff #900000 #900000

new_window normal
new_float normal

bindsym Print exec --no-startup-id flameshot gui -p ~/Pictures/Screenshots
bindsym $mod+Shift+x exec betterlockscreen -l blur

bindsym $mod+o exec --no-startup-id ~/.config/i3/hacker-startup.sh
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+
bindsym Control+Mod1+m exec --no-startup-id xfce4-popup-whiskermenu
exec_always --no-startup-id sh -c 'setxkbmap -layout deumlaut -option "" -option lv3:ralt_switch'
exec_always --no-startup-id sh -c 'pkill xcape; sleep 1; xcape -e "Super_L=Control_L|Alt_L|m"'
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu.sh
exec_always --no-startup-id xfce4-power-manager

exec_always --no-startup-id ~/.config/i3/scripts/brightness-watch.sh
