* {
    bg:      #1A120FEE;
    surface: #241A16;
    fg:      #F2E4DC;
    accent:  #FF8C42;
    urgent:  #E0483D;
    dim:     #8A7A72;

    background-color: transparent;
    text-color:       @fg;
    font:             "Fira Code Medium 11";
}
window   { background-color: @bg; border: 2px; border-color: @accent; border-radius: 6px; padding: 12px; width: 40%; }
inputbar { children: [prompt, entry]; padding: 6px; background-color: @surface; border-radius: 4px; }
prompt   { text-color: @accent; padding: 0 8px 0 0; }
listview { lines: 8; padding: 8px 0 0 0; }
element  { padding: 6px 10px; border-radius: 4px; }
element selected { background-color: @accent; text-color: @bg; }
element urgent   { text-color: @urgent; }
