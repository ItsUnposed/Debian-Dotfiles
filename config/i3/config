set $bg     #080C11
set $fg     #F0EDEB
set $red    #3D8FE0
set $orange #6BB6FF
set $inact  #121A22
set $dim    #333F4A
set $dkred  #1B5FA8
set $ltred  #6BB6FF
set $dkred  #1B5FA8
set $ltred  #6BB6FF

client.focused          $red     $bg      $ltred  $red      $red
client.focused_inactive $inact   $bg      $ltred  $inact    $inact
client.unfocused        $bg      $bg      $ltred  $bg       $bg
client.urgent           $red     $bg      $ltred  $red      $red

default_border normal 2
default_floating_border normal 2

exec_always --no-startup-id feh --no-fehbg --bg-fill $HOME/Pictures/Wallpapers/Blue.png
exec_always --no-startup-id export QT_QPA_PLATFORMTHEME=qt6ct
exec_always --no-startup-id xfsettingsd
exec --no-startup-id export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:$XDG_DATA_DIRS"

# i3 config file
# Mod-Taste: Alt
set $mod Mod4
bindsym $mod+m exec --no-startup-id xfce4-popup-whiskermenu

# Schriftart für Fenstertitel
font pango:DejaVu Sans Mono 10

# Autostart
floating_modifier $mod

for_window [instance="matrix-xterm"] border none
bindsym $mod+e exec --no-startup-id thunar
bindsym $mod+i exec --no-startup-id ~/.config/i3/scripts/dev-layout.sh
bindsym $mod+c exec --no-startup-id ~/.local/bin/chroma-gui
# Terminal-Spielereien
bindsym $mod+p exec --no-startup-id ~/.config/i3/scripts/hotkey-pipes.sh
bindsym $mod+x exec --no-startup-id ~/.config/i3/scripts/hotkey-matrix.sh

# Fenstergroesse aendern
bindsym $mod+Control+Left  resize shrink width  10 px or 10 ppt
bindsym $mod+Control+Right resize grow   width  10 px or 10 ppt
bindsym $mod+Control+Up    resize shrink height 10 px or 10 ppt
bindsym $mod+Control+Down  resize grow   height 10 px or 10 ppt


# Fenstergroesse direkt aendern

# Terminal starten
bindsym $mod+Return exec qterminal

# Fenster schließen
bindsym $mod+q kill

# Programm-Starter (rofi)
bindsym $mod+space exec ~/.config/i3/scripts/rofi-launcher.sh
bindsym $mod+d exec --no-startup-id rofi -show drun -theme ~/.config/rofi/chroma.rasi

# Fokus wechseln
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Fenster verschieben
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# Splits
bindsym $mod+h split h
bindsym $mod+v split v

# Vollbild
bindsym $mod+f fullscreen toggle

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed

# Floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus mode_toggle

# Fokus auf Elternfenster
bindsym $mod+a focus parent

# Workspaces wechseln
# set $ws10 "10"
# 

# Fenster zu Workspace verschieben

# Config neu laden / i3 neustarten / beenden
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
# bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Willst du wirklich ausloggen?' -B 'Ja' 'i3-msg exit'"


# Fokus folgt Maus
focus_follows_mouse yes

# Gaps
gaps inner 10
gaps outer 5
smart_gaps off

# Autostart
exec_always --no-startup-id xset b off
exec_always --no-startup-id xfce4-panel
exec_always --no-startup-id sh -c "pkill -x picom; sleep 2; exec picom -b"
exec --no-startup-id ~/.config/i3/hacker-startup.sh
bindsym $mod+Shift+h exec --no-startup-id ~/.config/i3/hacker-startup.sh
exec_always --no-startup-id sh -c "pkill -x nm-applet; sleep 1; exec nm-applet"
bindsym $mod+n exec --restart nm-applet

exec_always --no-startup-id sh -c "sleep 1; feh --no-fehbg --bg-fill $HOME/Pictures/Wallpapers/Blue.png"
# client.focused          #4C7899 #285577 #ffffff #2e9ef4 #285577
# client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a
# client.unfocused        #333333 #222222 #888888 #292d2e #222222
# client.urgent           #2f343a #900000 #ffffff #900000 #900000

new_window normal
new_float normal

bindsym Print exec --no-startup-id flameshot gui -p ~/Pictures/Screenshots
bindsym $mod+Shift+x exec betterlockscreen -l blur

bindsym $mod+o exec --no-startup-id ~/.config/i3/hacker-startup.sh
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+
exec_always --no-startup-id sh -c 'setxkbmap -layout deumlaut -option "" -option lv3:ralt_switch'
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu.sh
exec_always --no-startup-id sh -c "pkill -f xfce4-power-manager; sleep 1; exec xfce4-power-manager"

exec_always --no-startup-id ~/.config/i3/scripts/brightness-watch.sh

# --- Workspaces, feste Zahlen statt Variablen ---
bindsym $mod+1 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 1
bindsym $mod+2 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 2
bindsym $mod+3 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 3
bindsym $mod+4 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 4
bindsym $mod+5 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 5
bindsym $mod+6 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 6
bindsym $mod+7 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 7
bindsym $mod+8 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 8
bindsym $mod+9 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 9
bindsym $mod+0 exec --no-startup-id ~/.config/i3/scripts/ws-go.sh 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10


# --- Minimieren ---
bindsym $mod+minus exec --no-startup-id ~/.config/chroma/menu.sh


# --- Gaps: erzeugen den Rand beim Semi-Vollbild ---
gaps inner 10
gaps outer 4
smart_gaps off

# --- JetBrains ---
# Splash und Menue-Fenster muessen schweben, sonst bleiben Menues leer
for_window [class="^jetbrains-" title="^splash$"] floating enable, border none
# alle echten Fenster kacheln -> fuellen den Workspace, Gaps geben den Rand
for_window [class="^jetbrains-" title="^(?!splash$).*"] floating disable
bindsym $mod+t exec --no-startup-id ~/.config/i3/scripts/semifull.sh

# --- Claude Desktop: i3 zeichnet die fehlende Titelleiste ---
for_window [class="^com\.anthropic\.Claude$"] border normal 3

# --- Fibonacci-Kacheln ---
exec_always --no-startup-id python3 $HOME/.config/i3/scripts/autotile.py
