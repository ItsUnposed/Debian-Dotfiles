{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "debian_small",
    "color": {
      "1": "38;2;168;51;104",
      "2": "38;2;255;255;255"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 1
    }
  },
  "display": {
    "separator": " -> ",
    "color": {
      "keys": "38;2;168;51;104"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "1;38;2;255;143;196",
        "at": "1;38;2;255;255;255",
        "host": "1;38;2;224;90;155"
      }
    },
    {
      "type": "os",
      "key": "OS "
    },
    {
      "type": "kernel",
      "key": "KRN"
    },
    {
      "type": "cpu",
      "format": "{1} ({4})",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "MEM"
    },
    {
      "type": "uptime",
      "key": "UP "
    }
  ]
}