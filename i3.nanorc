syntax "i3" "i3/config$" "i3/config\.d/.*$"

# Kommentare
color bold,#f8c    "(^|[[:space:]])#.*"
# Schluesselwoerter
color #d59    "^[[:space:]]*(set|bindsym|bindcode|exec|exec_always|for_window|assign|font|mode|bar|workspace|floating_modifier|default_border|default_floating_border|hide_edge_borders|focus_follows_mouse|gaps|smart_gaps)\b"
color #d59    "^client\.[a-z_]+"
# Variablen
color #d59    "\$[A-Za-z_][A-Za-z0-9_]*"
# Hexfarben
color bold,#f8c    "#[0-9a-fA-F]{6}\b"

# Variablen
color bold,#a11 "\$[A-Za-z_][A-Za-z0-9_]*"
# Keywords
color #a11 "\<(set|bindsym|exec|exec_always|for_window|workspace|gaps|font|mode|bar|floating|focus|border|resize|assign|mark|unmark|kill|split|layout|fullscreen|sticky)\>"
# Zahlen und Hexfarben
color #a11 "\b[0-9]+\b"
color bold,#a11 "#[0-9a-fA-F]{3,6}\b"
