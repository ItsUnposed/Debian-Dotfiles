extendsyntax bash color bold,#f8c "(^|[[:space:]])#.*"
extendsyntax bash color #d59 "\<(if|fi|else|elif|for|while|do|done|case|esac|then|in|return|export|local|function|source)\>"
extendsyntax bash color #d59 "\$[A-Za-z_][A-Za-z0-9_]*|\$\{[^}]+\}|\$\([^)]+\)"
extendsyntax bash color #f8c "\"[^\"]*\"|'[^']*'"
extendsyntax bash color #d59 "\b[0-9]+\b"
