extendsyntax bash color #aaa "\<(if|fi|else|elif|for|while|do|done|case|esac|then|in|return|export|local|function|source)\>"
extendsyntax bash color #aaa "\$[A-Za-z_][A-Za-z0-9_]*|\$\{[^}]+\}|\$\([^)]+\)"
extendsyntax bash color #aaa "\"[^\"]*\"|'[^']*'"
extendsyntax bash color #aaa "\b[0-9]+\b"
