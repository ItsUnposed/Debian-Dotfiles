# --- Syntaxdateien, System zuerst ---
include /usr/share/nano/*.nanorc
include /usr/share/nano/extra/*.nanorc

# --- eigene Regeln, muessen danach kommen ---
include ~/.nano/i3.nanorc

# --- Oberflaeche im Chroma-Schema ---
set titlecolor    #111,#eee
set statuscolor   #111,#eee
set errorcolor    #eee,#666
set numbercolor   #aaa
set keycolor      #eee
set functioncolor #eee
set promptcolor   #eee,#111
set selectedcolor #111,#eee

# --- Komfort ---
set linenumbers
set tabsize 4
set tabstospaces
set constantshow
set softwrap
extendsyntax asm color bold,#eee "(^|[[:space:]])#.*"
extendsyntax asm color bold,#eee "//.*"
extendsyntax asm color #aaa start="/\*" end="\*/"
extendsyntax asm color #aaa "(^|[[:space:]])--[[:space:]].*"
extendsyntax asm color #aaa "(^|[[:space:]])%.*"
extendsyntax asm color #aaa "(^|[[:space:]]);.*"
