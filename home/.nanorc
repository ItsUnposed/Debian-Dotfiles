# --- Syntaxdateien, System zuerst ---
include /usr/share/nano/*.nanorc
include /usr/share/nano/extra/*.nanorc

# --- eigene Regeln, muessen danach kommen ---
include ~/.nano/i3.nanorc

# --- Oberflaeche im Ember-Schema ---
set titlecolor    #111,#f8c
set statuscolor   #111,#f8c
set errorcolor    #eee,#a36
set numbercolor   #d59
set keycolor      #f8c
set functioncolor #eee
set promptcolor   #eee,#111
set selectedcolor #111,#f8c

# --- Komfort ---
set linenumbers
set tabsize 4
set tabstospaces
set constantshow
set softwrap
extendsyntax asm color bold,#f8c "(^|[[:space:]])#.*"
extendsyntax asm color bold,#f8c "//.*"
extendsyntax asm color #d59 start="/\*" end="\*/"
extendsyntax asm color #d59 "(^|[[:space:]])--[[:space:]].*"
extendsyntax asm color #d59 "(^|[[:space:]])%.*"
extendsyntax asm color #d59 "(^|[[:space:]]);.*"
