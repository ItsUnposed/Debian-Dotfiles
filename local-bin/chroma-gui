    def np_load(self, combo):
        name = combo.get_active_text()
        if not name:
            return
        v = parse_conf(f"{PALDIR}/{name}.conf")
        for key, _ in self.FIELDS:
            if v.get(key):
                self.np_btns[key].set_rgba(rgba(v[key]))
        if hasattr(self, "np_term"):
            self.np_term.set_text(v.get("C_TERM", "white"))

    def np_save(self, _b):
        name = self.np_name.get_text().strip().lower()
        if not re.fullmatch(r"[a-z0-9-]{2,20}", name):
            self.say("Use two to twenty lowercase letters, digits or hyphens.")
            return
        target = f"{PALDIR}/{name}.conf"
        if os.path.exists(target):
            self.say(f"A palette called '{name}' already exists.")
            return

        def hexof(btn):
            c = btn.get_rgba()
            return "#%02X%02X%02X" % (int(c.red * 255), int(c.green * 255),
                                      int(c.blue * 255))

        base = parse_conf(f"{PALDIR}/{self.np_base.get_active_text()}.conf")
        wall = self.np_wall.get_text().strip()
        wallpath = (f"{WALLDIR}/{wall}" if wall
                    else base.get("WALLPAPER", f"{WALLDIR}/{name.capitalize()}.png"))

        lines = [f'NAME={name}']
        for key, _ in self.FIELDS:
            lines.append(f'{key}="{hexof(self.np_btns[key])}"')
        lines.append(f'C_TERM={self.np_term.get_text().strip() or "white"}')
        lines.append(f'WALLPAPER={wallpath}')
        with open(target, "w") as f:
            f.write("\n".join(lines) + "\n")
        group = self.np_group.get_child().get_text().strip() or "Other"
        groups = load_groups()
        groups = [(t, [x for x in ns if x != name]) for t, ns in groups]
        for i, (t, ns) in enumerate(groups):
            if t.lower() == group.lower():
                ns.append(name)
                break
        else:
            groups.append((group, [name]))
        save_groups(groups)

        self.say(f"Palette '{name}' created in group '{group}'. "
                 f"Reopen Chroma Control to see it.")

