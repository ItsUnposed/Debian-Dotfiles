    def pick_face(self, _b):
        d = self._chooser("Profile picture")
        if d.run() == Gtk.ResponseType.OK:
            src = d.get_filename()
            d.destroy()
            tmp = "/tmp/chroma-face.png"
            if not self._convert(src, tmp,
                                 ["-resize", "256x256^", "-gravity", "center",
                                  "-extent", "256x256"]):
                self.say("Conversion failed. Is ImageMagick installed?")
                return
            shutil.copy2(tmp, f"{HOME}/.face")
            self._thumb(self.pf_img, f"{HOME}/.face", 128, 128)
            user = os.environ.get("USER", "")
            ok = subprocess.run(
                ["pkexec", "install", "-m", "644", tmp,
                 f"/var/lib/AccountsService/icons/{user}"],
                capture_output=True).returncode == 0
            run("systemctl", "restart", "accounts-daemon") if ok else None
            self.say("Profile picture updated." if ok else
                     "Saved to ~/.face, but the login screen copy needs a password.")
        else:
            d.destroy()

    def save_host(self, _b):
        name = self.pf_host.get_text().strip()
        if not re.fullmatch(r"[a-zA-Z0-9-]{1,63}", name):
            self.say("Use letters, digits and hyphens only.")
            return
        ok = subprocess.run(["pkexec", "hostnamectl", "set-hostname", name],
                            capture_output=True).returncode == 0
        self.say(f"Machine renamed to '{name}'. Restart the terminal to see it."
                 if ok else "Renaming was cancelled or failed.")

    # --------------------------------------------------------- 9 Startup
    def tab_auto(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(14)
        box.pack_start(Gtk.Label(
            label="Unticking an entry comments it out; nothing is deleted.",
            xalign=0), False, False, 0)

        self.astore = Gtk.ListStore(bool, str, int)
        for i, line in enumerate(read(I3).splitlines()):
            m = re.match(r"^(#\s*)?(exec(?:_always)?\s+.*)$", line)
            if m:
                self.astore.append([m.group(1) is None, m.group(2), i])

        tree = Gtk.TreeView(model=self.astore)
        rt = Gtk.CellRendererToggle()
        rt.connect("toggled", self.toggle_auto)
        tree.append_column(Gtk.TreeViewColumn("On", rt, active=0))
        rx = Gtk.CellRendererText()
        rx.set_property("editable", True)
        rx.set_property("ellipsize", Pango.EllipsizeMode.END)
        rx.connect("edited", lambda _r, p, n: self.astore.__setitem__(p, [self.astore[p][0], n, self.astore[p][2]]))
        c = Gtk.TreeViewColumn("Command", rx, text=1)
        c.set_expand(True)
        tree.append_column(c)

        sc = Gtk.ScrolledWindow()
        sc.add(tree)
        box.pack_start(sc, True, True, 0)

        b = Gtk.Button(label="Save and reload i3")
        b.connect("clicked", self.save_auto)
        b.set_halign(Gtk.Align.START)
        box.pack_start(b, False, False, 0)
        return box

    def toggle_auto(self, _r, path):
        self.astore[path][0] = not self.astore[path][0]

    def save_auto(self, _b):
        lines = read(I3).splitlines()
        for row in self.astore:
            on, cmd, idx = row[0], row[1], row[2]
            if 0 <= idx < len(lines):
                lines[idx] = cmd if on else "# " + cmd
        write(I3, "\n".join(lines) + "\n")
        run("i3-msg", "reload")
        self.say("Startup entries saved and i3 reloaded.")

