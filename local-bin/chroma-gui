    def _outputs(self):
        try:
            out = subprocess.run(["xrandr", "--query"], capture_output=True,
                                 text=True).stdout
        except Exception:
            return []
        res = []
        for line in out.splitlines():
            m = re.match(r"^(\S+) connected(?: primary)?\s*(\d+x\d+)?", line)
            if m:
                res.append((m.group(1), m.group(2) or "off"))
        return res

