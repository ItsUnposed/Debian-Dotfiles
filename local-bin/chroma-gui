# Everything Chroma Control may write to, used by the backup page.
MANAGED = [I3, PICOM, QTERM, PIPES, MATRIX, HACKER, DEV, MENUSH, CAVA,
           f"{CHROMA}/current.conf", f"{CHROMA}/groups.conf"]
GREETER = "/etc/lightdm/lightdm-gtk-greeter.conf"
