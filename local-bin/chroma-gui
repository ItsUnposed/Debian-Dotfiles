    def edit_opacity(self, _r, path, new):
        try:
            v = float(new.replace(",", "."))
        except ValueError:
            self.say("Opacity must be a number between 0.1 and 1.0.")
            return
        v = min(max(v, 0.1), 1.0)
        self.ostore[path][1] = f"{v:.2f}"

    def save_opacity(self, _b):
        lines = read(PICOM).splitlines()
        for row in self.ostore:
            match, val, idx = row[0], row[1], row[2]
            if not (0 <= idx < len(lines)):
                continue
            line = lines[idx]
            line = re.sub(r'match\s*=\s*"[^"]+"', f'match = "{match}"', line, count=1)
            line = re.sub(r"opacity\s*=\s*[\d.]+", f"opacity = {val}", line, count=1)
            lines[idx] = line
        write(PICOM, "\n".join(lines) + "\n")
        self._restart_picom("Opacity rules saved")


    def save_menu(self, _b):
        ticked = {n for n, c in self.menu_checks.items() if c.get_active()}
        main = [n for n in self.menu_order if n in ticked]
        main += [n for n in sorted(ticked) if n not in main]
        if not main:
            self.say("At least one palette has to stay in the direct list.")
            return
        t = read(MENUSH)
        if not t:
            self.say("menu.sh not found.")
            return
        line = "HAUPT_ORDER=(" + " ".join(main) + ")"
        if re.search(r"^HAUPT_ORDER=\([^)]*\)", t, re.M):
            t = re.sub(r"^HAUPT_ORDER=\([^)]*\)", line, t, count=1, flags=re.M)
        else:
            self.say("HAUPT_ORDER line not found in menu.sh.")
            return
        write(MENUSH, t)
        os.chmod(MENUSH, 0o755)
        self.menu_order = main
        self.say(f"Menu layout saved: {len(main)} shown directly, "
