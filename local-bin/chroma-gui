        return g

    def save_login(self, _b):
        c = read(GREETER)
        if not c:
            self.say("Cannot read the greeter config.")
            return
        pairs = {
            "font-name": self.g_font.get_text(),
            "clock-format": self.g_clock.get_text(),
            "position": self.g_pos.get_text(),
            "round-user-image": "true" if self.g_round.get_active() else "false",
            "hide-user-image": "true" if self.g_hide.get_active() else "false",
            "panel-position": self.g_panel.get_active_text() or "top",
        }
        for k, v in pairs.items():
            if re.search(rf"^{k}=.*$", c, re.M):
                c = re.sub(rf"^{k}=.*$", f"{k}={v}", c, flags=re.M)
            else:
                c = c.rstrip() + f"\n{k}={v}\n"
        tmp = "/tmp/lightdm-gtk-greeter.conf.new"
        with open(tmp, "w") as f:
            f.write(c)
        ok = subprocess.run(
            ["pkexec", "cp", tmp, GREETER], capture_output=True).returncode == 0
        self.say("Login screen saved." if ok
                 else f"Could not write. Run manually: sudo cp {tmp} {GREETER}")


