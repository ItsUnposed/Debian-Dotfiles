                b.connect("toggled", self.ws_click, k, out)
                self.ws_buttons[(k, out)] = b
                grid.pack_start(b, False, False, 0)
            card.pack_start(grid, False, False, 0)
            frame.add(card)
            box.pack_start(frame, False, False, 0)

        row = Gtk.Box(spacing=8)
        row.set_margin_top(12)
        ev = Gtk.Button(label="Distribute evenly")
        ev.connect("clicked", self.ws_even, names)
        row.pack_start(ev, False, False, 0)

        ar = Gtk.Button(label="Remember this arrangement")
        ar.set_tooltip_text("Stores the current xrandr layout with autorandr")
        ar.connect("clicked", self.ar_save)
        row.pack_start(ar, False, False, 0)

        b = Gtk.Button(label="Apply and reload i3")
        b.get_style_context().add_class("primary")
        b.connect("clicked", self.save_displays)
        row.pack_end(b, False, False, 0)
        box.pack_start(row, False, False, 0)
        return box

    def ws_click(self, btn, ws, out):
        if getattr(self, "_ws_busy", False):
            return
        if not btn.get_active():
            if self.ws_map.get(ws) == out:
                btn.set_active(True)
            return
        self._ws_busy = True
        self.ws_map[ws] = out
        for (k, o), b in self.ws_buttons.items():
            if k == ws and o != out:
                b.set_active(False)
        self._ws_busy = False

    def ws_even(self, _b, names):
        self._ws_busy = True
        for i in range(1, 11):
            k = "0" if i == 10 else str(i)
            target = names[min((i - 1) * len(names) // 10, len(names) - 1)]
            self.ws_map[k] = target
            for (kk, o), b in self.ws_buttons.items():
                if kk == k:
                    b.set_active(o == target)
        self._ws_busy = False
        self.say("Workspaces spread evenly across the screens.")

    def ar_save(self, _b):
        if not shutil.which("autorandr"):
            self.say("autorandr is not installed: sudo apt install autorandr")
            return
        name = "-".join(o for o, _ in self._outputs()).lower()[:40] or "layout"
        r = subprocess.run(["autorandr", "--save", name, "--force"],
                           capture_output=True, text=True)
        self.say(f"Arrangement stored as '{name}'." if r.returncode == 0
                 else "autorandr could not store the arrangement.")

    def save_displays(self, _b):
        cfg = read(I3)
        if not cfg:
            self.say("Cannot read the i3 config.")
            return
        cfg = re.sub(r"^workspace\s+\S+\s+output\s+\S+.*\n", "", cfg, flags=re.M)
        cfg = re.sub(r"\n*# >>> chroma-displays.*?# <<< chroma-displays\n", "\n",
                     cfg, flags=re.S)

        block = ["", "# >>> chroma-displays (managed by Chroma Control)"]
        for i in range(1, 11):
            k = "0" if i == 10 else str(i)
            out = self.ws_map.get(k)
            if out:
                block.append(f"workspace {k} output {out}")
        block.append("# <<< chroma-displays")
        cfg = cfg.rstrip() + "\n" + "\n".join(block) + "\n"
        write(I3, cfg)
        run("i3-msg", "reload")
        self.say("Workspace assignment saved and i3 reloaded.")

    # ---------------------------------------------------------- Backups
    def tab_backups(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(18)

        head = Gtk.Label(label="RESTORE A BACKUP", xalign=0)
        head.get_style_context().add_class("section")
        box.pack_start(head, False, False, 0)

        note = Gtk.Label(xalign=0)
        note.get_style_context().add_class("dim")
        note.set_markup("<small>Every change made here writes a timestamped "
                        "copy first. Pick one to roll back to.</small>")
        box.pack_start(note, False, False, 0)

        self.bstore = Gtk.ListStore(str, str, str)   # file, when, full path
        found = []
        for f in MANAGED:
            found += glob.glob(f"{f}.bak-*")
        for d in (f"{CFG}/i3", f"{CFG}/i3/scripts", CHROMA, CFG,
                  f"{CFG}/qterminal.org", f"{CFG}/cava"):
            found += glob.glob(f"{d}/*.bak-*")
        found = sorted(set(found))
        for f in sorted(found, key=os.path.getmtime, reverse=True):
            base = os.path.basename(f)
            orig, _, stamp = base.rpartition(".bak-")
            when = datetime.datetime.fromtimestamp(
                os.path.getmtime(f)).strftime("%d.%m. %H:%M")
            self.bstore.append([orig, when, f])

        tree = Gtk.TreeView(model=self.bstore)
        r0 = Gtk.CellRendererText()
        r0.set_property("family", "monospace")
        c0 = Gtk.TreeViewColumn("File", r0, text=0)
        c0.set_expand(True)
        tree.append_column(c0)
        tree.append_column(Gtk.TreeViewColumn("Saved", Gtk.CellRendererText(), text=1))
        self.btree = tree

        sc = Gtk.ScrolledWindow()
        sc.add(tree)
        box.pack_start(sc, True, True, 0)

        row = Gtk.Box(spacing=8)
        mk = Gtk.Button(label="Back up everything now")
        mk.connect("clicked", self.bak_now)
        row.pack_start(mk, False, False, 0)
        cl = Gtk.Button(label="Delete all backups")
        cl.connect("clicked", self.bak_clear)
        row.pack_start(cl, False, False, 0)
        b = Gtk.Button(label="Restore selected")
        b.get_style_context().add_class("primary")
        b.connect("clicked", self.bak_restore)
        row.pack_end(b, False, False, 0)
        box.pack_start(row, False, False, 0)
        return box

    def bak_now(self, _b):
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        made = 0
        for f in MANAGED:
            if not os.path.isfile(f):
                continue
            try:
                shutil.copy2(f, f"{f}.bak-{stamp}")
                made += 1
            except Exception:
                pass
        when = datetime.datetime.now().strftime("%d.%m. %H:%M")
        for f in MANAGED:
            if os.path.isfile(f"{f}.bak-{stamp}"):
                self.bstore.insert(0, [os.path.basename(f), when,
                                       f"{f}.bak-{stamp}"])
        self.say(f"{made} files backed up.")

    def bak_restore(self, _b):
        model, it = self.btree.get_selection().get_selected()
        if not it:
            self.say("Pick a backup first.")
            return
        src = model[it][2]
        dst = src.rsplit(".bak-", 1)[0]
        try:
            shutil.copy2(dst, dst + ".before-restore")
            shutil.copy2(src, dst)
        except Exception as e:
            self.say(f"Could not restore: {e}")
            return
        if dst.endswith("i3/config"):
            run("i3-msg", "reload")
        elif dst.endswith("picom.conf"):
            self._restart_picom("Backup restored")
            return
        self.say(f"Restored {os.path.basename(dst)}.")

    def bak_clear(self, _b):
        n = 0
        for row in self.bstore:
            try:
                os.remove(row[2])
                n += 1
            except Exception:
                pass
        self.bstore.clear()
        self.say(f"{n} backups deleted.")


