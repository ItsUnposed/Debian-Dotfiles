def mix(a, b, t):
    """Blend two #rrggbb colours, t = 0..1 towards b."""
    a, b = a.lstrip("#"), b.lstrip("#")
    try:
        out = []
        for i in (0, 2, 4):
            x, y = int(a[i:i + 2], 16), int(b[i:i + 2], 16)
            out.append(int(x + (y - x) * t))
        return "#%02x%02x%02x" % tuple(out)
    except Exception:
        return "#" + a


def load_css():
    v = parse_conf(f"{CHROMA}/current.conf")
    bg   = v.get("C_BG",   "#101014")
    bg2  = v.get("C_BG2",  mix(bg, "#ffffff", 0.06))
    fg   = v.get("C_FG",   "#e8e8e8")
    dim  = v.get("C_DIM",  mix(fg, bg, 0.45))
    acc  = v.get("C_ACC",  "#ff6b5e")
    acc2 = v.get("C_ACC2", acc)
    acc3 = v.get("C_ACC3", mix(bg, acc, 0.22))
    css = (CSS_TEMPLATE
           .replace("@BG2@", bg2).replace("@BG@", bg)
           .replace("@FG@", fg).replace("@DIM@", dim)
           .replace("@ACC3@", acc3).replace("@ACC2@", acc2)
           .replace("@ACC@", acc)
           .replace("@LINE@", mix(bg, fg, 0.16))
           .replace("@HOVER@", mix(bg2, fg, 0.07)))
    prov = Gtk.CssProvider()
    try:
        prov.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    except Exception:
        pass


