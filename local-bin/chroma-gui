DEFAULT_GROUPS = [
    ("Blues",           ["aqua", "blue", "darkblue"]),
    ("Reds and pinks",  ["red", "pink", "purple"]),
    ("Warm tones",      ["yellow", "orange"]),
    ("Nature tones",    ["green", "brown"]),
    ("Neutrals",        ["black", "gray", "silver", "white"]),
]
GROUPFILE = f"{CHROMA}/groups.conf"


def load_groups():
    """Read the group file, fall back to the built in list."""
    text = read(GROUPFILE)
    if not text.strip():
        return [(t, list(n)) for t, n in DEFAULT_GROUPS]
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        title, _, rest = line.partition(":")
        out.append((title.strip(), rest.split()))
    return out or [(t, list(n)) for t, n in DEFAULT_GROUPS]


def save_groups(groups):
    body = "# One group per line:  Title: palette palette ...\n"
    for title, names in groups:
        if names:
            body += f"{title}: {' '.join(names)}\n"
    write(GROUPFILE, body)


# --------------------------------------------------------------- helpers
def read(path):
    try:
        with open(path) as f:
            return f.read()
    except Exception:
        return ""


def write(path, text):
    if os.path.exists(path):
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        try:
            shutil.copy2(path, f"{path}.bak-{stamp}")
        except Exception:
            pass
    try:
        with open(path, "w") as f:
            f.write(text)
        return True
    except Exception:
        return False


def run(*cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def parse_conf(path):
    out = {}
    for line in read(path).splitlines():
        line = line.strip()
        if "=" in line and not line.startswith("#"):
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def rgba(h):
    c = Gdk.RGBA()
    c.parse(h if h.startswith("#") else f"#{h}")
    return c


