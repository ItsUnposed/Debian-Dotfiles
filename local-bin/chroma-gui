    def _thumb(self, image, path, w=150, h=90):
        try:
            from gi.repository import GdkPixbuf
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w, h, True)
            image.set_from_pixbuf(pb)
        except Exception:
            image.set_from_icon_name("image-missing", Gtk.IconSize.DIALOG)

    def _chooser(self, title):
        d = Gtk.FileChooserDialog(title=title, parent=self,
                                  action=Gtk.FileChooserAction.OPEN)
        d.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                      Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        d.set_current_folder(os.path.expanduser("~/Pictures"))
        f = Gtk.FileFilter()
        f.set_name("Images and PDF")
        for pat in ("*.png", "*.jpg", "*.jpeg", "*.webp", "*.avif", "*.pdf",
                    "*.PNG", "*.JPG", "*.JPEG"):
            f.add_pattern(pat)
        d.add_filter(f)
        return d

    def _convert(self, src, dst, extra=None):
        """Convert any supported image to a real PNG at dst."""
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        src_arg = src + "[0]" if src.lower().endswith(".pdf") else src
        for tool in ("magick", "convert"):
            cmd = [tool, src_arg] + (extra or []) + [dst]
            try:
                r = subprocess.run(cmd, capture_output=True, timeout=90)
                if r.returncode == 0 and os.path.exists(dst):
                    return True
            except Exception:
                continue
        return False

    def pick_wall(self, _b, target, image, name):
        d = self._chooser(f"Background for '{name}'")
        if d.run() == Gtk.ResponseType.OK:
            src = d.get_filename()
            d.destroy()
            base = os.path.splitext(target)[0]
            for old in glob.glob(base + ".*"):
                if old != target:
                    try:
                        os.remove(old)
                    except Exception:
                        pass
            if self._convert(src, target):
                self._thumb(image, target)
                self.say(f"Background for '{name}' replaced. "
                         f"Re-apply the palette to see it.")
            else:
                self.say("Conversion failed. Is ImageMagick installed?")
        else:
            d.destroy()

    def set_wall(self, path):
        if not run("feh", "--bg-fill", path):
            run("xwallpaper", "--zoom", path)
        self.say(f"Background set to {os.path.basename(path)}.")

