    def _read_swipe(self, cfg):
        out = {}
        m = re.search(re.escape(self.MARK_A) + r"(.*?)" + re.escape(self.MARK_B),
                      cfg, re.S)
        if m:
            for key in ("open", "close", "ws", "dur_open", "dur_close", "dur_ws", "distance"):
                mm = re.search(rf"#\s*{key}\s*=\s*(.+)", m.group(1))
                if mm:
                    out[key] = mm.group(1).strip()
        return out

    def _anim_block(self, triggers, preset, dur, dist):
        if not preset:
            return ""
        lines = []
        for prop, (a, b) in preset.items():
            aa = a.replace("60", str(dist)).replace("-60", "-" + str(dist))
            bb = b.replace("60", str(dist)).replace("-60", "-" + str(dist))
            q = lambda v: f'"{v}"'
            lines.append(f'        {prop} = {{ curve = "cubic-bezier(0.22,1,0.36,1)"; '
                         f'duration = {dur}; start = {q(aa)}; end = {q(bb)}; }};')
        body = "\n".join(lines)
        trig = ", ".join(f'"{t}"' for t in triggers)
        return ("      {\n"
                f"        triggers = [ {trig} ];\n"
                f"{body}\n"
                '        blur-opacity = "opacity";\n'
                '        shadow-opacity = "opacity";\n'
                "      },\n")

    def _drop_top_animations(self, cfg):
        """Remove an existing top-level animations = ( ... ); list."""
        m = re.search(r"^animations\s*=\s*\(", cfg, re.M)
        if not m:
            return cfg
        i = cfg.index("(", m.start())
        depth = 0
        for j in range(i, len(cfg)):
            if cfg[j] in "([{":
                depth += 1
            elif cfg[j] in ")]}":
                depth -= 1
                if depth == 0:
                    end = j + 1
                    while end < len(cfg) and cfg[end] in ";\n":
                        end += 1
                    return cfg[:m.start()] + cfg[end:]
        return cfg

    def _insert_into_rules(self, cfg, entry):
        """Append our entry as the last item of rules = ( ... ), or None."""
        m = re.search(r"^rules\s*=\s*\(", cfg, re.M)
        if not m:
            return None
        i = cfg.index("(", m.start())
        depth = 0
        for j in range(i, len(cfg)):
            if cfg[j] in "([{":
                depth += 1
            elif cfg[j] in ")]}":
                depth -= 1
                if depth == 0:
                    return cfg[:j] + entry + cfg[j:]
        return None

    def save_swipe(self, _b):
        cfg = read(PICOM)
        if not cfg:
            self.say("Cannot read picom.conf.")
            return

        o = self.sw_open.get_active_text() or "None"
        c = self.sw_close.get_active_text() or "None"
        w = self.sw_ws.get_active_text() or "None"
        do = f"{self.sw_dur_o.get_value():.2f}"
        dc = f"{self.sw_dur_c.get_value():.2f}"
        dw = f"{self.sw_dur_w.get_value():.2f}"
        dist = self.sw_dist.get_value_as_int()

        anims = ""
        anims += self._anim_block(["open"], self.OPEN_PRESETS.get(o), do, dist)
        anims += self._anim_block(["close"], self.CLOSE_PRESETS.get(c), dc, dist)
        head = (f"  {self.MARK_A}\n"
                f"  # open = {o}\n  # close = {c}\n  # ws = {w}\n"
                f"  # dur_open = {do}\n  # dur_close = {dc}\n"
                f"  # dur_ws = {dw}\n"
                f"  # distance = {dist}\n")
        entry = head
        if anims:
            # one catch-all rule so every window animates, not just some
            entry += ("  {\n"
                      "    animations = (\n"
                      + anims +
                      "    );\n"
                      "  },\n")
        entry += f"  {self.MARK_B}\n"

        # remove our previous entry wherever it sits
        pat = re.escape(self.MARK_A) + r".*?" + re.escape(self.MARK_B) + r"\n?"
        cfg = re.sub(r"[ \t]*" + pat, "", cfg, flags=re.S)
        cfg = re.sub(r"^\s*fading\s*=\s*(true|false)\s*;?\s*$", "", cfg, flags=re.M)

        # a rule right before ours must keep its separating comma
        cfg = re.sub(r"\}\s*\n(\s*)\)", r"},\n\1)", cfg)
        cfg = re.sub(r"\},\s*,", "},", cfg)

        if not self._insert_into_rules(cfg, entry):
            # no rules list in this config, fall back to top level
            top = entry.replace("  " + self.MARK_A, self.MARK_A)
            if anims:
                cfg = self._drop_top_animations(cfg)
                cfg = cfg.rstrip() + "\n\n" + self.MARK_A + "\nanimations = (\n" \
                      + anims + ");\n" + self.MARK_B + "\n"
            else:
                cfg = cfg.rstrip() + "\n\n" + self.MARK_A + "\n" + self.MARK_B + "\n"
            write(PICOM, cfg)
        else:
            cfg = self._insert_into_rules(cfg, entry)
            write(PICOM, cfg)

        # the workspace slide lives in the older _MY_CUSTOM_WORKSPACE_SWITCH
        # rules, which sit before our block and therefore win
        cfg2 = read(PICOM)
        if "_MY_CUSTOM_WORKSPACE_SWITCH" in cfg2:
            cfg2 = re.sub(r"(_MY_CUSTOM_WORKSPACE_SWITCH.*?)\n\s*\},\n",
                          lambda m: re.sub(r"duration = [\d.]+",
                                           f"duration = {dw}", m.group(0)),
                          cfg2, flags=re.S)
            write(PICOM, cfg2)

        key = self.sw_fskey.get_child().get_text().strip()
        if key:
            i3c = read(I3)
            line = f"bindsym {key} fullscreen disable"
            if re.search(r"^bindsym \S+ fullscreen disable", i3c, re.M):
                i3c = re.sub(r"^bindsym \S+ fullscreen disable", line, i3c, flags=re.M)
            else:
                i3c = re.sub(r"^(bindsym \$mod\+f fullscreen toggle)",
                             rf"\1\n{line}", i3c, count=1, flags=re.M)
            write(I3, i3c)
            run("i3-msg", "reload")

        self._restart_picom("Animations saved")


