QMenuBar {
    background-color: #0D0A09;
    color: #F2E4DC;
    border: 0px;
}
QMenuBar::item {
    background: transparent;
    color: #F2E4DC;
    padding: 4px 10px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #2A100C;
    color: #FF6B5E;
}
QMenu {
    background-color: #0D0A09;
    color: #F2E4DC;
    border: 1px solid #A11C12;
}
QMenu::item {
    color: #F2E4DC;
    padding: 4px 24px;
}
QMenu::item:selected {
    background-color: #2A100C;
    color: #FF6B5E;
}
QMenu::item:disabled {
    color: #6A5A54;
}
QMenu::separator {
    background-color: #A11C12;
    height: 1px;
    margin: 3px 6px;
}
QToolBar, QStatusBar {
    background-color: #0D0A09;
    color: #F2E4DC;
    border: 0px;
}
QTabBar::tab {
    background-color: #0D0A09;
    color: #F2E4DC;
    padding: 4px 12px;
}
QTabBar::tab:selected {
    background-color: #2A100C;
    color: #FF6B5E;
}

QScrollBar:vertical {
    background-color: #0D0A09;
    width: 10px;
    margin: 0px;
    border: 0px;
}
QScrollBar::handle:vertical {
    background-color: #A11C12;
    min-height: 24px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #FF6B5E;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: #0D0A09;
}
QScrollBar:horizontal {
    background-color: #0D0A09;
    height: 10px;
    border: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #A11C12;
    min-width: 24px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #FF6B5E;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: 0px;
}
